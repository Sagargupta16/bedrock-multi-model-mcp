{
  "name": "bedrock-multi-model-mcp",
  "version": "0.5.0",
  "mcpName": "io.github.Sagargupta16/bedrock-multi-model-mcp",
  "description": "MCP server for AWS Bedrock - text, image, video, and embeddings across Claude, Llama, Mistral, Nova, Qwen, DeepSeek, GPT-OSS and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bedrock-multi-model-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc && npm run copy-data",
    "copy-data": "node --eval \"const{cpSync,mkdirSync}=require('node:fs');mkdirSync('dist/data',{recursive:true});cpSync('src/data','dist/data',{recursive:true});\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aws",
    "bedrock",
    "llama",
    "mistral",
    "nova",
    "qwen",
    "deepseek",
    "gpt-oss",
    "multi-model",
    "converse-api"
  ],
  "author": "Sagar Gupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sagargupta16/bedrock-multi-model-mcp.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "rimraf": "^6.0.0",
    "typescript": "^7.0.2"
  }
}
